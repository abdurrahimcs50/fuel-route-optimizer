# Django
DJANGO_SECRET_KEY=changeme
DJANGO_DEBUG=True

# Routing: OSRM public demo server, no API key required. See plan.md.
ROUTING_API_BASE_URL=https://router.project-osrm.org

# Geocoding: Nominatim (OpenStreetMap), no API key required. Used both by
# the live request path (start/finish) and the offline geocode_stations
# command. Set GEOCODING_USER_AGENT to something identifying this app per
# Nominatim's usage policy.
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=fuel-route-optimizer (youremail@example.com)
